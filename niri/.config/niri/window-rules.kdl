window-rule {
    match app-id="bluetooth-manager"
    match app-id="network-manager"
    match app-id="wdisplays"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 500; }
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"google-chrome$"# title="^Meet -"
    match app-id=r#"Google-chrome$"# title="^Meet -"
    match app-id=r#"google-chrome$"# title="^DevTools"
    match app-id=r#"Google-chrome$"# title="^DevTools"
    match app-id=r#"Google-chrome$"# title="^Browser Extension"
    match app-id=r#"Google-chrome$"# title="^Sign in - Google Accounts"
    match app-id=r#"Google-chrome$"# title="^Pay with Paypal"
    open-floating true
}

window-rule {
    match app-id=r#"blueman-manager$"#
    open-floating true
}

window-rule {
    match app-id=r#"pavucontrol$"#
    open-floating true
}

window-rule {
    match app-id=r#"xdg-desktop-portal-gnome$"#
    open-floating true
}

window-rule {
    match app-id=r#"^wallpaper-picker$"#
    open-floating true
}

window-rule {
    match app-id=r#"nm-connection-editor"# title="^Network Connections$"
    open-floating true
}

window-rule {
    match app-id="Postman"
    open-maximized true
}

