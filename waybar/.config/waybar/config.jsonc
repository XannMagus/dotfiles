// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    // "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 0, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "niri/workspaces",
        "cffi/niri-windows",
    ],
    "modules-center": [
        "custom/corner-left",
        "niri/window",
        "custom/corner-right",
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "custom/media",
        "cpu",
        "memory",
        "battery",
        "clock",
        "custom/bluetooth",
        "network",
        "tray",
        "group/power"
    ],
    // Modules configuration
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "\uf192",
            "default": "\uf111"
        }
    },
    "custom/corner-left": { "format": " " },
    "custom/corner-right": { "format": " " },
    "niri/window": {
        "format": "{app_id}|{title}",
        "max-length": 90,
        "rewrite": {
            "^foot\\|nvim (.*): .*": "\ue6ae $1",
            "^foot\\|lazygit : (.*)": "\udb80\udea2 $1",
            "^foot\\|lazydocker : (.*)": "\uf21f $1",
            "^foot\\|(?!(nvim|lazygit|lazydocker)) (.*)": "\uf489  $1",
            "^spotify\\|(.*)$": "\uf1bc $1",
            "^spotify\\|Spotify Premium$": "\uf1bc Nothing playing",
            "^Google-chrome\\|(.*) - Google Chrome$": "\uf268 $1",
            "^slack\\|(.*) - Slack$": "\uf198 $1",
            "^yazi\\|Yazi: (.*)$": "\udb80\udde5 $1",
            "^jetbrains-phpstorm\\|(.*)$": "\ue862 $1",
            "^steam\\|(.*)$": "\uf1b6 $1",
            "^(?!(foot|spotify|slack|Google-chrome|yazi|jetbrains-phpstorm|steam)).*\\|(.*)":"$2"
        }
    },
    "cffi/niri-windows": {
        // path where you placed the .so file
        "module_path": "/home/ahmed/.config/waybar/waybar-niri-windows.so",
        // configure the module's behavior
        "options": {
            // set the module mode
            // "graphical" (default): draw a minimap of windows in the current workspace
            // "text": draws symbols and a focus indicator for each column (mirrors v1 behavior)
            "mode": "graphical",

            "show-floating": "never",
            "floating-position": "right",
            "minimum-size": 1,
            "spacing": 1,
            "icon-minimum-size": 5,
            "column-borders": 0, // border on .column
            "floating-borders": 0, // border on .floating
            "on-tile-click": "FocusWindow", // (default: FocusWindow)
            "on-tile-middle-click": "CloseWindow", // (default: CloseWindow)
            "on-tile-right-click": "", // (default: none)
            "rules": [
                { "app-id": "foot", "title": "^lazygit", "class": "git", "icon": "\udb80\udea2" },
                { "app-id": "foot", "title": "^lazydocker", "class": "docker", "icon": "\uf21f" },
                { "app-id": "foot", "title": "^nvim", "class": "nvim", "icon": "\ue6ae" },
                { "app-id": "foot", "class": "foot", "icon": "\uf489" },
                { "app-id": "yazi", "class": "yazi", "icon": "\udb80\udde5" },
                { "app-id": "Slack", "class": "slack", "icon": "\uf198" },
                { "app-id": "spotify", "class": "spotify", "icon": "\uf1bc" },
                { "app-id": "Spotify", "class": "spotify", "icon": "\uf1bc" },
                { "app-id": "Postman", "class": "postman", "icon": "\ue86b" },
                { "app-id": "jetbrains-phpstorm", "class": "jetbrains-phpstorm", "icon": "\ue862" },
                { "app-id": "steam", "class": "steam", "icon": "\uf1b6" },
                { "app-id": "discord", "class": "discord", "icon": "\uf1ff" },
                { "app-id": "Google-chrome", "class": "chrome", "icon": "\uf268","continue": true },
                { "title": "YouTube Music$", "class": "youtube-music", "icon": "" },
                { "app-id": "bruno", "class": "bruno", "icon": "\udb82\ude43" }
            ],

            // ======= text mode options =======
            // customize the symbols used to draw the columns/windows
            "symbols": {
                "unfocused": "⋅",
                "focused": "⊙",
                "unfocused-floating": "∗",
                "focused-floating": "⊛",
                // text to display when there are no windows on the current workspace
                // if this is an empty string (default), the module will be hidden when there are no windows
                "empty": ""
            }
        },
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\uf06e",
            "deactivated": "\uf070"
        },
        "tooltip": true,
        "tooltip-format-activated": "screen won't sleep",
        "tooltip-format-deactivated": "screen will sleep"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}% {format_source}",
        "format-bluetooth": "{icon} \uf294 {volume}% {format_source}",
        "format-bluetooth-muted": "\udb81\udf5f {icon} \uf294 {format_source}",
        "format-muted": "\udb81\udf5f {format_source}",
        "format-source": "",
        "format-source-muted": "\uf131",
        "format-icons": {
            "headphone": "\uf025",
            "hands-free": "\udb80\udece",
            "headset": "\udb80\udece",
            "phone": "\uf095",
            "portable": "\uf095",
            "car": "\uf1b9",
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 50,
        "format-icons": {
            "spotify": "\uf1bc",
            "default": "\udb81\udf5a",
            "Paused": "\uf04c",
            "Playing": "\uf04b",
            "Stopped": "\uf04d"
        },
        "escape": true,
        "exec": "playerctl metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"tooltip\": \"{{playerName}}: {{artist}} - {{album}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' 2>/dev/null || echo ''",
        "on-click": "playerctl play-pause",
        "interval": 2
    },
    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-right": false,
        },
        "modules": [
            "custom/power",
            "custom/logout",
            "custom/suspend",
            "custom/reboot",
        ]
    },
    "custom/power": {
        "format" : "\u23fb ",
		"tooltip": false,
        "on-click": "systemctl poweroff",
		// "menu": "on-click",
		// "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		// "menu-actions": {
		// 	"shutdown": "shutdown",
		// 	"reboot": "reboot",
		// 	"suspend": "systemctl suspend",
		// 	"logout": "niri msg action quit"
		// }
    },
    "custom/logout": {
        "format": "\uf08b ",
        "tooltip": false,
        "on-click": "niri msg action quit",
    },
    "custom/suspend": {
        "format": "\udb82\udd04 ",
        "tooltip": false,
        "on-click": "systemctl suspend",
    },
    "custom/reboot": {
        "format": "\uead2 ",
        "tooltip": false,
        "on-click": "systemctl reboot",
    },
    "custom/bluetooth": {
        "exec": "$XDG_CONFIG_HOME/waybar/bt-status.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{icon}",
        "format-icons": {
            "on": "\udb80\udcaf",
            "off": "\udb80\udcb2",
            "connected": "\udb80\udcb1",
        },
        "on-click": "foot --app-id bluetooth-manager bluetui",
        "tooltip": true,
        "on-click-right": "rfkill toggle bluetooth",
    },
    "tray": {
        "spacing": 5,
        "icons": {
          "blueman": "bluetooth",
        }
    },
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format": "󰅐 {:%H:%M}",
        "format-alt": "󰃭 {:%Y-%m-%d}"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": " {}%"
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-full": "{icon}",
        "format-charging": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": {
            "charging": ["󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰂃", "󰁺", "󰁻", "󰁻", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        }
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format": "\udb80\ude00",
        "format-wifi": "{icon}",
        "format-ethernet": "\udb80\ude00",
        "tooltip-format-wifi": "{ifname}: {essid} ({ipaddr})",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}",
        "format-disconnected": "\udb81\uddaa",
        "format-disabled": "\udb81\uddaa",
        "format-icons": {
            "default": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"],
            "degraded": ["\udb82\udd2b", "\udb82\udd20", "\udb82\udd23", "\udb82\udd26", "\udb82\udd29"]
        },
        "on-click": "foot --app-id network-manager impala"
    }
}
